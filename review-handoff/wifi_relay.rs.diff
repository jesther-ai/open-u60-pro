+/// One adaptation step per watcher tick.
+fn tune_width(link: &mut LinkWidth) -> Result<(), String> {
+    let info = Cmd::new("iw", &["dev", IFACE, "info"]).run()?;
+    let (primary, actual, _) = width::parse_channel(&info).ok_or("Cannot read the upstream channel width")?;
+    let expected = link.tuner.width();
+    if actual > link.tuner.widest() || actual < expected {
+        // The link itself changed (AP or reassociation): measure from here.
+        *link = LinkWidth::new(std::mem::take(&mut link.network), actual, actual, link.airtime);
+        return Ok(());
+    }
+    if actual > expected {
+        // A reassociation widened it again.
+        return set_width(expected);
+    }
+    let now = std::time::Instant::now();
+    let bytes: u64 = fs::read_to_string(format!("/sys/class/net/{IFACE}/statistics/rx_bytes"))
+        .ok()
+        .and_then(|b| b.trim().parse().ok())
+        .ok_or("Cannot read upstream traffic counters")?;
+    let airtime = if link.airtime {
+        match llstats::read(IFACE).ok().and_then(|stats| llstats::rx_airtime(&stats, primary)) {
+            Some(ms) => Some(ms),
+            None => {
+                // Never compare the two scores: start this session's
+                // measurement again on the AP's rate.
+                *link = LinkWidth::new(std::mem::take(&mut link.network), link.tuner.widest(), expected, false);
+                return Ok(());
+            }
+        }
+    } else {
+        None
+    };
+    let sample = match (link.last, airtime) {
+        (Some((at, before, Some(before_ms))), Some(ms)) => width::airtime_rate(now.duration_since(at).as_secs_f64(), bytes.saturating_sub(before), ms.saturating_sub(before_ms)),
+        (Some((at, before, _)), None) if width::busy(now.duration_since(at).as_secs_f64(), bytes.saturating_sub(before)) => {
+            width::parse_rx_rate(&Cmd::new("iw", &["dev", IFACE, "station", "dump"]).run()?)
+        }
+        _ => None,
+    };
+    link.last = Some((now, bytes, airtime));
+    let change = link.tuner.tick(now, sample);
+    if let Some(settled) = link.tuner.take_settled() {
+        // Not fatal: the next connection then predicts again.
+        let _ = width::remember(&Path::new(JOURNAL).join(WIDTHS), &link.network, settled);
+    }
+    change.map_or(Ok(()), set_width)
+}
