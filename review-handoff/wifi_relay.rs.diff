+/// After association: start at the width settled on last time for this
+/// network, else at the one the scan's neighbours predict.
+fn start_width(network: &str, neighbours: &[(u32, i32)]) -> Option<LinkWidth> {
+    let (primary, negotiated, center) = width::parse_channel(&Cmd::new("iw", &["dev", IFACE, "info"]).run().ok()?)?;
+    let start = width::remembered(&Path::new(JOURNAL).join(WIDTHS), network)
+        .filter(|&w| w <= negotiated)
+        .unwrap_or_else(|| width::predict(primary, negotiated, center, neighbours));
+    let link = LinkWidth::new(network.to_owned(), negotiated, start, llstats::enable(IFACE).is_ok());
+    if link.tuner.width() < negotiated {
+        // Not fatal: the watcher re-applies a width that did not take.
+        let _ = set_width(link.tuner.width());
+    }
+    Some(link)
+}
